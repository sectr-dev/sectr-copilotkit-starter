# The AG-UI endpoint of your agent's route — `sectr dev` and `sectr deploy`
# both print it ("connect via AG-UI at: …").
SECTR_AGUI_URL=https://api.sectr.dev/ag-ui/support-agent/chat

# Deployed agents only (leave unset for `sectr dev`): the app's invocation
# key, from the dashboard (Settings → API keys). Server-side only — it mints
# per-user tokens in app/api/agent-token and never reaches the browser.
SECTR_INVOCATION_KEY=
