# Loaded by `npm run dev` only (never by `next build` / `next start`).
# `sectr dev`'s default AG-UI URL for the agent in agent/. If `sectr dev` says
# it picked another port, put the URL it printed in .env.local, which
# overrides this file.
SECTR_AGUI_URL=https://local.sectr.dev:8420/ag-ui/support-agent/chat
